      "node": "./src/adaptadores/meta.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@rikuy/contracts": "*",
    "@rikuy/core": "*",
    "@rikuy/curriculum-cneb": "*",
    "@rikuy/tutor": "*",
    "zod": "^4.6.7"
  }
}
