{
  "name": "@rikuy/ai",
  "version": "0.1.0",
  "private": true,
  "description": "AI ports and adapters, router and budget. Gemini/Meta adapters are node-only (server keys).",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./adaptadores/gemini": {
