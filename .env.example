# Copiar a .env y completar. Sin nada configurado, el tutor funciona con
# el agente de reglas (sin internet, sin costo).

# Puerto del servidor (la web en desarrollo usa 5173 y redirige /api y /ws aquí)
PORT=8787
# Carpeta donde se guardan los eventos de aprendizaje (JSONL por sala)
DATA_DIR=./data

# Proveedor del tutor: vacío = reglas | anthropic | openai
LLM_PROVIDER=

# Opción A: Claude (requiere internet)
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-haiku-5-5

# Opción B: cualquier API compatible con OpenAI, p. ej. Ollama en la laptop
# del docente (sin internet): ollama pull qwen3:4b
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# LLM_MODEL=qwen3:4b
