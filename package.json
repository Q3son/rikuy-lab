{
  "name": "rikuy-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Laboratorio de ciencias holográfico y agéntico para colegios sin laboratorio (Hack4Edu 2026, Reto 17).",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm run dev -w @rikuy/server\" \"npm run dev -w @rikuy/web\"",
    "build": "npm run build -w @rikuy/web",
    "start": "npm run start -w @rikuy/server",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e/tsconfig.json",
    "lint": "eslint .",
    "lint:deps": "depcruise packages apps --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "axe-core": "^4.14.0",
    "concurrently": "^10.0.6",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
